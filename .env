# Token du bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Ton ID Discord (clic droit sur ton profil > Copier l'ID, mode développeur requis)
OWNER_ID=

# Secret partagé entre le bot Discord et l'API Flask du site (choisis une chaîne aléatoire toi-même)
DISCORD_BOT_API_SECRET=

# URL du site Flask de contrôle (jules88.pythonanywhere.com)
SITE_URL=https://jules88.pythonanywhere.com

# Identifiants du mot de passe de bot Vikidia, créés via Spécial:BotPasswords
# (connecté sur le compte Jules88!!Bot), format NomDuCompte@NomDuMotDePasse
VIKIDIA_BOT_USERNAME=
VIKIDIA_BOT_PASSWORD=